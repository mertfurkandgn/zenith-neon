  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#A193D7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment keyword.codetag",
        "comment storage.type.class.jsdoc",
        "comment punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#FC68DA",
        "fontStyle": "italic bold"
      }
    },
    {
      "scope": [
        "comment entity.name.type.instance.jsdoc",
        "comment variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#FDD692",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#919DBF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "support.variable",
        "variable.other.php",
        "punctuation.definition.variable.php",
        "meta.definition.variable variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#E2E3F6"
      }
    },
    {
      "scope": [
